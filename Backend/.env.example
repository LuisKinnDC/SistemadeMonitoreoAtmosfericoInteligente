# ==========================================================
#  Variables de entorno del proyecto
# ==========================================================
# 1. Copia este archivo a  ".env"  (sin .example)
# 2. Rellena con tus credenciales reales de Supabase
# 3. NUNCA subas el archivo .env a git (ya está en .gitignore)
#
# Encuentra estos valores en:
#   Supabase -> Project Settings -> API
# ----------------------------------------------------------

# URL del proyecto (ej: https://abcdefgh.supabase.co)
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública "anon" (suficiente para lectura si RLS lo permite)
# Para ingesta con permisos completos usa la "service_role" key.
SUPABASE_KEY=TU_CLAVE_ANON_O_SERVICE_ROLE

# Nombre de la tabla de lecturas
TABLA_LECTURAS=lecturas_sensores
