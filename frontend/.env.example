# ==========================================================
#  Variables de entorno del frontend (Vite)
# ==========================================================
# 1. Copia este archivo a  ".env.local"
# 2. Rellena con tus credenciales de Supabase.
#
# IMPORTANTE: Vite SOLO expone al navegador las variables que
# empiezan con "VITE_". La clave publishable/anon está DISEÑADA
# para usarse en el cliente (queda protegida por RLS en Supabase),
# así que es correcto ponerla aquí. NUNCA pongas la service_role key.
# ----------------------------------------------------------

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_PUBLISHABLE_O_ANON
VITE_TABLA_LECTURAS=lecturas_sensores
